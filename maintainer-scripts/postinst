#!/bin/sh
set -e

# Remove old GUI binary from v1.0.8 (was klip-gui, now just klip)
# Note: the old /usr/bin/klip (daemon) is correctly replaced by the
# new /usr/bin/klip (GUI) automatically during dpkg upgrade.
for old_bin in /usr/bin/klip-gui /usr/local/bin/klip-gui; do
    if [ -f "$old_bin" ]; then
        rm -f "$old_bin"
    fi
done

# Remove old service file (renamed klip.service → klipd.service)
for old_svc in /usr/lib/systemd/user/klip.service /usr/local/lib/systemd/user/klip.service; do
    if [ -f "$old_svc" ]; then
        rm -f "$old_svc"
    fi
done

# Remove old desktop file (renamed klip-gui.desktop → klip.desktop)
if [ -f /usr/share/applications/klip-gui.desktop ]; then
    rm -f /usr/share/applications/klip-gui.desktop
fi

# Restart running klipd user services so they pick up the new binary (an old
# daemon doesn't understand requests added in newer GUI versions)
for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
    user=$(id -nu "$uid" 2>/dev/null) || continue
    systemctl --user -M "$user@" try-restart klipd.service >/dev/null 2>&1 || true
done

exit 0
